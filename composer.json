{
    "name": "aiutoma/aiutoma-dev",
    "description": "Developer Companion for Aiutoma",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0"
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r 'foreach (glob(\"vendor/dompdf/dompdf/lib/fonts/DejaVu*\") as $f) { @unlink($f); }'"
        ],
        "post-update-cmd": [
            "@php -r 'foreach (glob(\"vendor/dompdf/dompdf/lib/fonts/DejaVu*\") as $f) { @unlink($f); }'"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
